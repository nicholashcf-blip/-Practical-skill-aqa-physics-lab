# ── Supabase ──────────────────────────────────────────────────────────────────
# Copy this file to `.env` (or `.env.local`) and fill in the values from your
# Supabase project: Settings → API → Project URL and `anon` public key.
# These are PUBLIC keys safe to ship in the client bundle — RLS protects data.

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
